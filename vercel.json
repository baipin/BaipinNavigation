{
  "rewrites": [
    {
      "source": "/api/site-metadata",
      "destination": "/api/sync?content=metadata"
    },
    {
      "source": "/api/discover",
      "destination": "/api/sync?content=discover"
    },
    {
      "source": "/api/music",
      "destination": "/api/sync?content=music"
    },
    {
      "source": "/api/feishu/callback",
      "destination": "/api/sync?provider=feishu&action=callback"
    },
    {
      "source": "/api/feishu",
      "destination": "/api/sync?provider=feishu"
    },
    {
      "source": "/api/microsoft/callback",
      "destination": "/api/sync?provider=microsoft&action=callback"
    },
    {
      "source": "/api/microsoft",
      "destination": "/api/sync?provider=microsoft"
    },
    {
      "source": "/api/icloud",
      "destination": "/api/sync?provider=icloud"
    },
    {
      "source": "/api/canvas",
      "destination": "/api/sync?provider=canvas"
    }
  ],
  "functions": {
    "api/sync.js": {
      "maxDuration": 60
    }
  }
}
